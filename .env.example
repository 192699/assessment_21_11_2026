# Copy to .env for local npm-based development.
# docker compose uses the defaults in docker-compose.yml and does not require this file.

API_PORT=3001
WEB_ORIGIN=http://localhost:5173

# Product data source (swap this URL / adapter later without touching the client)
PRODUCT_SOURCE_URL=https://fakestoreapi.com
PRODUCT_CACHE_TTL_MS=300000

# Featured counts
FEATURED_COUNT=5
CATEGORY_FEATURED_COUNT=3

# Email — point SMTP at Mailpit locally, SES (or similar) later
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SALES_INBOX=sales@example.com
FROM_EMAIL=catalogue@example.com
